{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"python ../back-end/manage.py runserver 127.0.0.1:8000\" \"vite\"",
    "dev:api": "python ../back-end/manage.py runserver 127.0.0.1:8000",
    "dev:web": "vite",
    "build": "vite build",
    "build:django": "vite build --mode django",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "6.4.4"
  }
}
